---
/**
 * The east window: three lancets glazed in individual quarries.
 * The centre light holds the real v4 sprite, backlit, on the engine's own idle.
 * The flanking lights are the world he came back to — green and thriving, doing
 * fine without him. Art direction §1.4 locks that contrast: a lush world, one
 * pale skeleton, which is why nothing but the centre light ever holds a figure.
 *
 * **He wears his own skull and only his own.** The window briefly cycled the
 * eight generated bone sets, and the generated heads are a working set rather
 * than approved art — cycling them put the weakest art on the site on a 4.5s
 * loop at the top of the page, which is the one place a visitor is guaranteed to
 * look. One head that is right beats eight that are not. The three-layer split
 * below is kept exactly as it was, so a swap is still a drop-in when the drawn
 * heads land and there is something worth cycling.
 *
 * The window is drawn wider than its own viewBox on purpose. The outer lights
 * run off both edges because a cathedral window is bigger than the room you
 * stand in to look at it — and because the crop is in the viewBox rather than in
 * CSS, it is the same crop at every breakpoint and on the social card, with no
 * overflow trick to keep in step.
 *
 * Colours come from src/tokens.ts, which is the same source the stylesheet reads.
 * Quarry variation is seeded, so the glazing is identical on every build.
 *
 * `still` is the capture surface's flag: /og-card is screenshotted headlessly, so
 * an animating window would land on whichever frame the capture happened to
 * catch. Still stops the idle and the sun and drops the caption.
 */
import { url } from '../paths';
import { palette as C, glazing } from '../tokens';

interface Props {
  still?: boolean;
}

const { still = false } = Astro.props;

const BASE = 556; // the sill line; the figure's feet land exactly on it

/** Equilateral gothic arch, struck from the opposite springer. */
function lancet(x0: number, x1: number, ys: number) {
  const w = x1 - x0;
  const cx = (x0 + x1) / 2;
  const apex = +(ys - (w * Math.sqrt(3)) / 2).toFixed(2);
  return `M ${x0} ${BASE} L ${x0} ${ys} A ${w} ${w} 0 0 1 ${cx} ${apex} A ${w} ${w} 0 0 1 ${x1} ${ys} L ${x1} ${BASE} Z`;
}

/** Deterministic hash so the glazing never shuffles between builds. */
const rnd = (i: number, j: number, s: number) => {
  const n = Math.sin(i * 127.1 + j * 311.7 + s * 74.7) * 43758.5453;
  return n - Math.floor(n);
};

type Light = { id: string; x0: number; x1: number; ys: number; glass: readonly string[] };

/* The outer two start left of 0 and end right of 780 — the viewBox is the crop,
   32 units off each side. Putting it here rather than in CSS is what makes it
   the same crop on a phone, on a desktop and on the social card. */
const lights: Light[] = [
  { id: 'l', x0: -32, x1: 198, ys: 350, glass: glazing.green },
  { id: 'c', x0: 220, x1: 560, ys: 320, glass: glazing.indigo },
  { id: 'r', x0: 582, x1: 812, ys: 350, glass: glazing.rust },
];

const MID = 390; // the centre light's axis, and the figure's

const S = 40; // quarry pitch

/** A diamond lattice of quarries covering a light's bounding box. */
function quarries(l: Light, seed: number) {
  const h = S / 2;
  const out: { d: string; fill: string; o: number }[] = [];
  const top = l.ys - (l.x1 - l.x0) * 0.87 - S;
  for (let j = 0; top + j * h < BASE + S; j++) {
    const y = top + j * h;
    for (let i = -1; l.x0 + i * S < l.x1 + S; i++) {
      const x = l.x0 + i * S + (j % 2 ? h : 0);
      const r = rnd(i, j, seed);
      out.push({
        d: `M ${x} ${y - h} L ${x + h} ${y} L ${x} ${y + h} L ${x - h} ${y} Z`,
        fill: l.glass[Math.floor(r * l.glass.length)]!,
        /* rounded like every other generated number here: 17 significant digits
           × hundreds of quarries is kilobytes of the index for no visible
           difference, and the low bits are where Math.sin can differ between
           JS engines. */
        o: +(0.62 + rnd(j, i, seed + 9) * 0.38).toFixed(2),
      });
    }
  }
  return out;
}

/**
 * Glaze once. The lead net is one path holding every quarry outline as a
 * subpath — identical output to a path per quarry, hundreds of fewer nodes.
 */
const glazed = lights.map((l, i) => {
  const q = quarries(l, i * 17 + 3);
  return { ...l, outline: lancet(l.x0, l.x1, l.ys), quarries: q, net: q.map((p) => p.d).join(' ') };
});

/* ── the figure ──────────────────────────────────────────────────────────────
   Three stacked layers on one 100×100 lattice, cut on the game repo's own row
   72 — the documented leg cut, where the pelvis stops being a solid block and
   the two femurs separate. `legs` is planted; `upper` (torso, pelvis, arms)
   carries the skull and takes the idle bob. Verified: legs + upper + own skull
   recomposite onto the shipped base at 0 pixels differing, which is the same
   acceptance test the rig's own cuts are held to.

   The bob is 1 source pixel DOWNWARD, which is not a detail: measured off the
   engine's own idle capture, pose B sits 1px lower with the feet on the same
   row. Upward would open a 1px gap at the hip, because the femur heads live in
   `upper` and the shafts live in `legs`.

   The skull stays its own layer even though only one is ever drawn now. It is
   what the head swap costs nothing to reach: `upper` is cut below the neck, so a
   drawn head registered on the same 100×100 lattice drops in by filename alone.
   Merging it into `upper` would save one `<image>` and mean re-deriving the body
   layers to get it back. DESIGN.md §9 has the cases where the swap is not free. */
const FIG = 460; // side of the drawn 100×100 canvas, in user units
const FX = MID - FIG / 2; // his own centre column is x=50, so the canvas centres on the axis
const FY = BASE - FIG * 0.97; // row 97 is his ground line, so his feet meet the sill
const BOB = FIG / 100; // one source pixel, in user units

/** Rays struck from behind him — the last light in the world still pointed his way. */
const rays = Array.from({ length: 15 }, (_, i) => {
  const a = (-90 + (i - 7) * 12.4) * (Math.PI / 180);
  return { x: +(MID + Math.cos(a) * 580).toFixed(1), y: +(390 + Math.sin(a) * 580).toFixed(1) };
});
---

<figure class:list={['leaded', still && 'is-still']}>
  {/* `YMax`, not `YMid`: whatever height the bay has spare belongs above the
      window, as wall. Centred, the slack split in two and left ~120px of empty
      ink between the sill and the caption that names what is standing on it. */}
  <svg viewBox="0 10 780 580" role="img" aria-labelledby="win-title" preserveAspectRatio="xMidYMax meet">
    <title id="win-title">
      A three-light stained-glass window, wider than the frame that holds it. Ossuar's
      skeleton stands lit in the centre light, wearing his own skull. The flanking lights are
      glazed in green and rust quarries.
    </title>

    <defs>
      <radialGradient id="halo" cx="50%" cy="50%">
        <stop offset="0%" stop-color={C['glass-cyan-lit']} stop-opacity="0.9" />
        <stop offset="30%" stop-color={C['glass-cyan']} stop-opacity="0.38" />
        <stop offset="100%" stop-color={C['glass-cyan-lit']} stop-opacity="0" />
      </radialGradient>

      <linearGradient id="wash" x1="0" y1="0" x2="0.25" y2="1">
        <stop offset="0%" stop-color="#ffffff" stop-opacity="0.2" />
        <stop offset="48%" stop-color="#ffffff" stop-opacity="0.03" />
        <stop offset="100%" stop-color={C['ink-deep']} stop-opacity="0.45" />
      </linearGradient>

      <filter id="mottle" x="-5%" y="-5%" width="110%" height="110%">
        <feTurbulence type="fractalNoise" baseFrequency="0.55" numOctaves="3" seed="11" result="n" />
        <feColorMatrix in="n" type="saturate" values="0" result="g" />
        <feComponentTransfer in="g" result="soft">
          <feFuncA type="linear" slope="0.22" intercept="0" />
        </feComponentTransfer>
        <feComposite in="soft" in2="SourceGraphic" operator="in" />
      </filter>

      <filter id="bloom" x="-40%" y="-40%" width="180%" height="180%">
        <feGaussianBlur stdDeviation="18" />
      </filter>

      {glazed.map((l) => <clipPath id={`clip-${l.id}`}><path d={l.outline} /></clipPath>)}
    </defs>

    {/* stone ground behind the glazing */}
    {glazed.map((l) => <path d={l.outline} fill={C.lead} />)}

    {
      glazed.map((l) => (
        <g clip-path={`url(#clip-${l.id})`}>
          {/* the glazing itself */}
          {l.quarries.map((q) => (
            <path d={q.d} fill={q.fill} opacity={q.o} />
          ))}

          {/* Light behind the figure, in the centre light only. `.sun` is the slow
              drift that stops the glass reading as printed.

              The 0.62 is not a taste number picked here: this pair used to sit
              inside a `.flare` group that pulsed 1 → 0.62 on the beat a bone
              landed and then held at 0.62 for the rest of the round. With no
              bone landing there is no beat to greet, so the pulse went — and
              0.62 is the resting level it spent its life at, carried down onto
              the two elements that had it. The lit glass is unchanged. */}
          {l.id === 'c' && (
            <>
              <g class="sun" opacity="0.62">
                {rays.map((r) => (
                  <path
                    d={`M ${MID} 390 L ${r.x} ${r.y} L ${(r.x + 60).toFixed(1)} ${(r.y + 38).toFixed(1)} Z`}
                    fill={C['glass-violet']}
                    opacity="0.55"
                  />
                ))}
              </g>
              <circle cx={MID} cy="396" r="284" fill="url(#halo)" opacity="0.62" />
            </>
          )}

          {/* the lead net — one path, every quarry outline a subpath */}
          <path d={l.net} fill="none" stroke={C.lead} stroke-width="3.4" />

          {/* border band of gold quarries, the way a real light is edged */}
          <path d={l.outline} fill="none" stroke={C['glass-gold']} stroke-width="34" opacity="0.5" />
          <path
            d={l.outline}
            fill="none"
            stroke={C.lead}
            stroke-width="3.4"
            transform="translate(0,-17)"
            opacity="0.55"
          />
        </g>
      ))
    }

    {/* the figure, at true pixel scale, standing on the sill */}
    <g clip-path="url(#clip-c)">
      <ellipse
        cx={MID}
        cy="368"
        rx="166"
        ry="216"
        fill={C['glass-cyan-lit']}
        opacity="0.2"
        filter="url(#bloom)"
      />

      <image
        href={url('/art/hero/ossuar-legs.png')}
        x={FX}
        y={FY}
        width={FIG}
        height={FIG}
        style="image-rendering: pixelated"
      />

      {/* everything above the hips rides one transform, exactly as the rig's
          `Upper` node does — one curve rather than four. */}
      <g class="bob">
        <image
          href={url('/art/hero/ossuar-upper.png')}
          x={FX}
          y={FY}
          width={FIG}
          height={FIG}
          style="image-rendering: pixelated"
        />
        <image
          href={url('/art/hero/skull-own.png')}
          x={FX}
          y={FY}
          width={FIG}
          height={FIG}
          style="image-rendering: pixelated"
        />
      </g>
    </g>

    {/* glass surface: mottle, then the wash every real pane has */}
    {glazed.map((l) => <path class="mottle" d={l.outline} fill="#ffffff" filter="url(#mottle)" opacity="0.42" />)}
    {glazed.map((l) => <path d={l.outline} fill="url(#wash)" />)}

    {/* No saddle bars. A real leaded window has them and this one had two rounds
        of them; both were wrong, and the second was wrong in a way the first was
        not. Straightening them onto one pitch so they ran at the same height
        across all three lights — which is what a real multi-light window does —
        turned them into a cage: three unbroken horizontals across the full width,
        one of them at his throat. The first version escaped that only by having
        them land at different heights per light, which is to say by accident.
        The glazing already carries every bit of structure this needs — the quarry
        lattice, the leading, the border band, the came, the jambs and the sill —
        and the one thing in the picture is a figure. Horizontal rules across a
        figure at regular intervals read as bars in front of him, because that is
        what they are. See DESIGN.md §10. */}

    {/* mullions and the outer came */}
    {
      glazed.map((l) => (
        <path d={l.outline} fill="none" stroke={C.lead} stroke-width="17" stroke-linejoin="round" />
      ))
    }
    {
      glazed.map((l) => (
        <path d={l.outline} fill="none" stroke={C.bone} stroke-opacity="0.14" stroke-width="1.6" />
      ))
    }

    {/* The jambs. These are what make the crop a finished edge rather than a
        rendering fault: the outer lights are cut because the stone frame is in
        front of them, which is how you see a window that is wider than the
        opening you are looking through. Without them the cut only reads as
        deliberate while the glazing happens to reach the bay's own edge — and
        whether it does depends on the viewport's aspect, so it would be right on
        one screen and broken on the next. */}
    <g clip-path="url(#clip-l)">
      <rect x="0" y="10" width="15" height="580" fill={C.lead} />
      <rect x="15" y="10" width="1.6" height="580" fill={C.bone} opacity="0.14" />
    </g>
    <g clip-path="url(#clip-r)">
      <rect x="765" y="10" width="15" height="580" fill={C.lead} />
      <rect x="763.4" y="10" width="1.6" height="580" fill={C.bone} opacity="0.14" />
    </g>

    {/* the sill the whole window stands on — full bleed, because the window is */}
    <rect x="0" y={BASE} width="780" height="16" fill={C.lead} />
    <rect x="0" y={BASE} width="780" height="2" fill={C.bone} opacity="0.12" />
  </svg>

  {
    !still && (
      <figcaption>
        {/* One line, and the only reason it is here: without it this is a
            drawing of a skeleton, and with it it is the thing the game actually
            runs. `mono-note` is the site's own mono-sentence role — declaring the
            type here would be a second copy of it, which is the defect DESIGN.md
            §3 has already had to fix twice.
            It said "on the engine's own idle" for a while, which is a sentence
            written for the person who built it. A visitor has no use for what an
            idle is; what they have a use for is knowing the skeleton above is the
            game and not a drawing commissioned for a website. */}
        <span class="mono-note whence">
          The game's own sprite — not art made for this page.
        </span>
      </figcaption>
    )
  }
</figure>

<style define:vars={{ bob: `${BOB}px` }}>
  .leaded {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    justify-items: center;
    gap: clamp(0.8rem, 1.5vw, 1.25rem);
    width: 100%;
    height: 100%;
  }

  .leaded.is-still {
    grid-template-rows: minmax(0, 1fr);
  }

  .leaded svg {
    width: 100%;
    height: 100%;
  }

  /* ── the caption under the sill ───────────────────────────────────────── */
  figcaption {
    display: grid;
    justify-items: center;
    text-align: center;
    padding-inline: 1rem;
  }

  /* `.mono-note` caps the measure at 52ch, so the sentence can set as two lines
     on a narrow bay; `balance` is what stops one word sitting alone on the
     second. */
  .whence {
    text-wrap: balance;
  }

  /* ── the one line that makes the motion affordable ──────────────────────
     `#mottle` is an `feTurbulence` over three full lancets. It never changes,
     but it sits ON TOP of everything that does, and Chrome re-ran it on every
     repaint the animation caused: measured 42fps as shipped, 144fps with the
     filter deleted. `will-change: filter` caches its output instead, which
     measured **144fps with every clock still running** — identical to deleting
     it, and the grain stays.

     Two things this rules out, both measured and both useless here: promoting
     the animating elements instead (`will-change: transform` on `.sun`: 42fps)
     and `contain: paint` on these paths (42fps). The cost was never the
     animation — it was the filter underneath being asked to recompute.

     Cutting the bone cycle did not make this affordable: it took the clocks from
     four to two and the filter still costs the same. Re-measured with only the
     idle and the sun left — 34fps without this line, 144 with it, at 390, 1440
     and 1920 alike. Deleting it is not a cleanup.

     Scoped to `no-preference` because the promotion buys nothing when nothing
     animates, and a compositing layer per lancet is real memory on a phone. */
  @media (prefers-reduced-motion: no-preference) {
    .mottle {
      will-change: filter;
    }
  }

  /* the idle: 2 poses, 375ms each, the upper body 1 source pixel down on the
     second — the engine's own idle, reproduced on whole pixels so nothing
     resamples. `step-end` is what keeps it a pose change rather than a tween. */
  .bob {
    transform-box: view-box;
    animation: bob 0.75s step-end infinite;
  }

  @keyframes bob {
    0% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(var(--bob));
    }
  }

  /* the sun does not stand still, and neither should the thing lighting a window */
  /* `view-box` puts the reference box at the viewBox origin, which is y=10 here,
     so the ray fan's user-space origin of (390, 390) is 380 down the box. */
  .sun {
    transform-box: view-box;
    transform-origin: 390px 380px;
    animation: sun 64s ease-in-out infinite alternate;
  }

  @keyframes sun {
    from {
      transform: rotate(-3.5deg);
    }
    to {
      transform: rotate(3.5deg);
    }
  }

  /* `still` has to actually be still. /og.png is captured headlessly, and both
     clocks below advance on any capture path whose clock is real rather than
     virtual — so without this the social card lands on whichever pose and
     whichever sun angle the shot happened to catch, and no two regenerations of
     it match. Nothing here changes what is drawn, only that it holds. */
  .is-still .bob,
  .is-still .sun {
    animation: none;
  }

  /* Reduced motion stops both clocks. Every layer is declared visible, so what
     is left is the window exactly as it paints on frame one. */
  @media (prefers-reduced-motion: reduce) {
    .bob,
    .sun {
      animation: none;
    }
  }
</style>
