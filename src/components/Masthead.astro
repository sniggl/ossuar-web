---
/**
 * The same header on all three pages. The hrefs are site-root-relative on
 * purpose: `/#game` is a same-document fragment jump on the index and a real
 * navigation everywhere else, so one markup serves every page.
 */
import { url } from '../paths';
---

<header class="masthead">
  <a class="wordmark" href={url('/')}>Ossuar<span>.</span></a>
  <nav aria-label="Primary">
    <a href={url('/#game')}>The game</a>
    <a href={url('/#journal')}>Journal</a>
    <a href={url('/rss.xml')}>RSS</a>
  </nav>
</header>
