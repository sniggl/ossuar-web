---
/**
 * The follow band: every channel, under the journal, with the email slot beside
 * them. `newsletter.live` decides what fills that slot — the form, or the line
 * saying the list is waiting for the real domain.
 *
 * The slot is never removed. Empty-but-labelled is how this site handles what
 * does not exist yet; a section that vanishes reads as broken.
 */
import SubscribeForm from './SubscribeForm.astro';
import { channels, newsletter, feed } from '../links';
import { url } from '../paths';

/* The feed's href is an internal path, so it takes `url()` like every other
   internal link. The channel itself is declared in links.ts beside the rest. */
const all = [...channels, { ...feed, href: url(feed.href) }];
---

<section class="band" id="follow">
  <div class="band-head">
    <h2>Follow the build</h2>
  </div>

  {/* The order is the point: whichever of the two actually works goes first in
      the DOM, so the reading order, the tab order and the visual order stay the
      same one. While the list is off, the four channels lead and the slot closes
      the block; when it goes live the form leads and takes its own column.

      The slot is a row of this list rather than a column beside it, and that is
      what it is: a fifth place to follow this, not yet open. As its own column it
      was one line of type holding down half the band, so the band ended on a
      613×225 hole above the footer — measured, not impressioned. */}
  <div class:list={['band-body', newsletter.live && 'has-form']}>
    {newsletter.live && <SubscribeForm />}

    <ul class="channels">
      {
        all.map((c) => (
          <li>
            <a href={c.href}>{c.handle}</a>
            <span>{c.note}</span>
          </li>
        ))
      }

      {
        !newsletter.live && (
          <li class="closed">
            <p class="slug">By email</p>
            <span>The list opens with Ossuar's own domain.</span>
          </li>
        )
      }
    </ul>
  </div>
</section>

<style>
  .band-body {
    display: grid;
    gap: clamp(1.75rem, 4vw, 3.5rem);
    align-items: start;
  }

  /* Two columns only once the form is live. A form needs its own room; one line
     of type does not, and giving it a column anyway is what left the band
     lopsided. The flag decides how many things are in this band, so the flag
     decides how many columns it has. */
  .band-body.has-form {
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
  }

  /* `.slug` rather than a `<label>`: a label with no control to point at is a
     lie to a screen reader. It is the same type either way — and it is the
     channel link's type without the amber underline, because it is not
     somewhere you can go yet. */
  .subscribe :global(label),
  .slug {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--bone-dim);
  }

  /* stacked above its field; the closed row is a grid cell and sets its own */
  .subscribe :global(label) {
    margin: 0 0 0.75rem;
  }

  .closed .slug {
    margin: 0;
  }

  .channels {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    /* Two content-sized columns, centred as a block on the page axis.
       Equal `1fr` columns were measured leaning 280px left: each cell is a
       label plus a short note, so a wide cell leaves ~300px of trailing space,
       and the left column hides its trailing space in the gap while the right
       column puts its own against the page edge. Sizing the columns to their
       content and centring the block puts the same air on both sides. */
    grid-template-columns: repeat(2, auto);
    justify-content: center;
    gap: 0.9rem clamp(1.75rem, 4vw, 3.5rem);
  }

  /* The closing row: full width and centred, on the same axis as the band
     heading above it and the journal's own closing sentence. Four channels
     divide evenly into two columns and a fifth item does not — left in the
     grid it put three rows against two and hung the band's whole bottom-right
     corner empty, which is the asymmetry that read as the page leaning. */
  /* `.channels li.closed`, not `.closed`. Astro stamps every compound, so
     `.channels[cid] li[cid]` is (0,3,1) and a bare `.closed[cid]` is (0,2,0) —
     it loses, and `display: flex` silently never applied. Measured at 849px of
     left skew against a built page while the source looked correct. This is the
     specificity trap this codebase has now hit three times. */
  .channels li.closed {
    grid-column: 1 / -1;
    display: flex;
    /* wrap, or this row is the widest unbreakable thing in the band: a nowrap
       flex line's min-content is the sum of its items', so at a 32px root the
       slug and its note held the whole list at 268px inside a 240px band */
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    padding-top: 0.35rem;
  }

  /* back to one file when the form has taken the other column */
  .has-form .channels {
    grid-template-columns: minmax(0, 1fr);
  }

  /* The column is the grid's job, not the link's: give the anchor a min-width
     and its underline runs 7rem wide under a three-letter word.
     **`minmax(0, 7rem)`, not a bare `7rem`, and that is a text-zoom fix.** The
     track is in `rem`, so it scales with the reader's font-size setting while
     the viewport does not — at Chrome's 200% setting `7rem` is 224px of label
     column plus a 32px gap inside a 240px band, and the list pushed the whole
     document sideways. A `minmax(0, …)` track keeps 7rem as the width it wants
     and lets it give way when the row cannot have it, which is a no-op at every
     size where it fits. This is the same shape as the `minmax(0, 1fr)` on
     `.card` in og-card: a bare track keeps a minimum nobody asked for.
     This rule was also declared twice — an earlier copy set the same columns
     with `minmax(0, max-content)` on the note and lost to this one on source
     order, so the comment below described a declaration that never applied. */
  .channels li {
    display: grid;
    grid-template-columns: minmax(0, 7rem) minmax(0, 1fr);
    align-items: baseline;
    gap: 0.4rem 1rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid color-mix(in srgb, var(--bone) 9%, transparent);
  }

  .channels li:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  /* The link's own look — and its 44px box — are in global.css, because the
     journal entry foot prints the same channel from the same list. All that is
     left here is where the grid puts it. */
  .channels a {
    justify-self: start;
  }

  .channels span {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    letter-spacing: 0.01em;
    color: var(--bone-faint);
  }

  @media (max-width: 60rem) {
    .band-body.has-form {
      grid-template-columns: minmax(0, 1fr);
    }

    /* One file, still content-sized and still centred — a full-width column
       here left the list trailing 263px of empty band at 768px. What lets that
       same column shrink and wrap on a phone rather than overflow is the pair
       of `minmax(0, …)` tracks on the row above, not anything here. */
    .channels {
      grid-template-columns: auto;
    }
  }

  /* **The label stops sharing the row with its note when the row cannot hold
     both, and the trigger is `rem` on purpose.** `rem` inside a media query
     resolves against the *default* font size — the thing Chrome's "Font size"
     setting actually changes — so this one query tracks the reader's type size
     as well as the viewport, which is what a `px` breakpoint cannot do.
     19rem is 304px at the 16px default, below the 320px floor, so nothing about
     the shipped phone layout moves; at Chrome's "Very Large" (24px) it is 456px
     and at 200% (32px) it is 608px, which is every phone.
     Why it was needed: the note's track was squeezed to 11.7px and **the text
     overflowed the box rather than the box growing**, so every element's
     `getBoundingClientRect` still measured inside the viewport while the
     document scrolled 152px sideways. Bisect by hiding subtrees and read
     `documentElement.scrollWidth`; element boxes will tell you the page is
     fine. */
  @media (max-width: 19rem) {
    .channels li {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
