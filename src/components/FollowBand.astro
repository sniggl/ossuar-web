---
/**
 * The follow band: every channel, under the journal, with the email slot beside
 * them. `newsletter.live` decides what fills that slot — the form, or the line
 * saying the list is waiting for the real domain.
 *
 * The slot is never removed. Empty-but-labelled is how this site handles what
 * does not exist yet; a section that vanishes reads as broken.
 */
import SubscribeForm from './SubscribeForm.astro';
import { channels, newsletter, feed } from '../links';
import { url } from '../paths';

/* The feed's href is an internal path, so it takes `url()` like every other
   internal link. The channel itself is declared in links.ts beside the rest. */
const all = [...channels, { ...feed, href: url(feed.href) }];
---

<section class="band" id="follow">
  <div class="band-head">
    <h2>Follow the build</h2>
  </div>

  {/* The order is the point, and it is why the slot is rendered on both sides of
      the list rather than once with a CSS `order`: whichever of the two actually
      works goes first, in the wider column, in the DOM — so the reading order, the
      tab order and the visual order stay the same one. */}
  <div class="band-body">
    {newsletter.live && <SubscribeForm />}

    <ul class="channels">
      {
        all.map((c) => (
          <li>
            <a href={c.href}>{c.handle}</a>
            <span>{c.note}</span>
          </li>
        ))
      }
    </ul>

    {
      !newsletter.live && (
        <div class="subscribe">
          <p class="slug">By email</p>
          <p class="mono-note">The list opens with Ossuar's own domain.</p>
        </div>
      )
    }
  </div>
</section>

<style>
  .band-body {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(1.75rem, 4vw, 3.5rem);
    align-items: start;
  }

  /* `.slug` rather than a `<label>`: a label with no control to point at is a
     lie to a screen reader. It is the same type either way. */
  .subscribe :global(label),
  .slug {
    display: block;
    margin: 0 0 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--bone-dim);
  }

  .channels {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.9rem;
  }

  /* The column is the grid's job, not the link's: give the anchor a min-width
     and its underline runs 7rem wide under a three-letter word. */
  .channels li {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    align-items: baseline;
    gap: 0.4rem 1rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid color-mix(in srgb, var(--bone) 9%, transparent);
  }

  .channels li:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  /* The link's own look — and its 44px box — are in global.css, because the
     journal entry foot prints the same channel from the same list. All that is
     left here is where the grid puts it. */
  .channels a {
    justify-self: start;
  }

  .channels span {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    letter-spacing: 0.01em;
    color: var(--bone-faint);
  }

  @media (max-width: 60rem) {
    .band-body {
      grid-template-columns: 1fr;
    }
  }
</style>
