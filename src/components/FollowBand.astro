---
/**
 * The follow band: the newsletter form and every channel, once, under the
 * journal.
 *
 * The form is a plain POST to a Supabase Edge Function, because a static site
 * has nothing of its own to post to. That keeps the site at zero client
 * JavaScript — the browser's own `type="email"` validation and the function's
 * 303 redirect do everything a script would otherwise be hired for.
 */
import { discord, newsletter, reddit, twitch } from '../links';
import { url } from '../paths';

/**
 * The list waits for Ossuar's own domain, two days out. Collecting addresses
 * against the temporary one would mean migrating every subscriber later for
 * two days of signups on a site with no posts yet — so the slot is shown and
 * says so, which this site is already good at.
 *
 * Turning it on is this constant plus the seven secrets on the `subscribe`
 * function. The form, the endpoints, the tables and the three landing pages
 * are all shipped and tested; nothing else has to be built.
 */
const emailLive = false;

const channels = [
  { ...discord, note: 'the room where I build it' },
  { ...twitch, note: 'sometimes I build it live' },
  { ...reddit, note: 'posts, questions, arguments' },
  { href: url('/rss.xml'), handle: 'RSS', note: 'the raw feed, no middleman' },
];
---

<section class="lodge" id="follow">
  <div class="lodge-head">
    <h2>Follow the build</h2>
    <p>No account needed for any of it</p>
  </div>

  <div class="lodge-body">
    {
      emailLive ? (
        <form class="subscribe" method="post" action={newsletter.action}>
          <label for="sub-email">By email</label>

          <div class="field">
            <input
              id="sub-email"
              type="email"
              name="email"
              required
              autocomplete="email"
              spellcheck="false"
              placeholder="you@example.com"
            />
            <button type="submit">Send it</button>
          </div>

          {/* Off-screen rather than hidden: a bot fills every field it can parse,
              a person never reaches this one. It is the only spam guard a form
              without JavaScript gets, so the function drops anything that fills it. */}
          <p class="decoy" aria-hidden="true">
            <label for="sub-quarry">Leave this empty</label>
            <input id="sub-quarry" type="text" name="quarry" tabindex="-1" autocomplete="off" />
          </p>

          <p class="fine">
            One mail per journal entry, nothing else. You confirm the address before anything
            is sent, every mail carries a one-click unsubscribe, and it is stored in
            Frankfurt and used for nothing but this.
          </p>
        </form>
      ) : (
        <div class="subscribe">
          <p class="label">By email</p>
          <p class="fine">
            Not yet. The list waits for Ossuar's own domain, so that nobody who signs up has
            to be moved to another address later. Everything else here works today.
          </p>
        </div>
      )
    }

    <ul class="channels">
      {
        channels.map((c) => (
          <li>
            <a href={c.href}>{c.handle}</a>
            <span>{c.note}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .lodge {
    border-top: var(--lead-w) solid var(--lead);
    padding: clamp(2.5rem, 6vw, 4.5rem) var(--gutter) clamp(3rem, 7vw, 5rem);
  }

  /* the same head as the journal above it, so the page reads as two bands of
     one system rather than a section and an afterthought */
  .lodge-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .lodge-head h2 {
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    letter-spacing: 0.04em;
  }

  .lodge-head p {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--bone-faint);
  }

  .lodge-body {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(1.75rem, 4vw, 3.5rem);
    align-items: start;
  }

  /* ── the form ─────────────────────────────────────────── */
  /* `.label` is the same slug when the form is not live: a `<label>` with no
     control to point at is a lie to a screen reader. */
  .subscribe label,
  .subscribe .label {
    display: block;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--bone-dim);
    margin-bottom: 0.75rem;
  }

  .field {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  input[type='email'] {
    flex: 1 1 14rem;
    min-width: 0;
    padding: 0.85rem 1rem;
    border: var(--lead-w) solid var(--lead);
    background: var(--lead-soft);
    color: var(--bone);
    font-family: var(--font-mono);
    /* 0.95rem: the floor is 0.85rem and this is something you have to read
       back to check for a typo, so it sits a step above it */
    font-size: 0.95rem;
    letter-spacing: 0.01em;
  }

  input[type='email']::placeholder {
    color: var(--bone-faint);
    opacity: 0.7;
  }

  input[type='email']:focus-visible {
    outline: 2px solid var(--glass-amber-lit);
    outline-offset: 2px;
  }

  /* the plaque from the hero, lit from behind by the same amber glass — the
     site has one button shape and this is it */
  button {
    position: relative;
    flex: none;
    padding: 0.85rem 1.4rem;
    border: var(--lead-w) solid var(--lead);
    background: var(--lead-soft);
    color: var(--bone);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    isolation: isolate;
    overflow: hidden;
  }

  button::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(130% 170% at 18% 0%, var(--glass-amber) 0%, transparent 72%);
    opacity: 0.3;
    transition: opacity 0.24s ease;
  }

  button:hover::before,
  button:focus-visible::before {
    opacity: 0.58;
  }

  .decoy {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .fine {
    margin: 1.1rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    line-height: 1.6;
    letter-spacing: 0.01em;
    color: var(--bone-faint);
    max-width: 52ch;
  }

  /* ── the channel list ─────────────────────────────────── */
  .channels {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.9rem;
  }

  /* The column is the grid's job, not the link's: give the anchor a min-width
     and its underline runs 7rem wide under a three-letter word. */
  .channels li {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    align-items: baseline;
    gap: 0.4rem 1rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid color-mix(in srgb, var(--bone) 9%, transparent);
  }

  .channels li:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .channels a {
    justify-self: start;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--bone);
    text-decoration: none;
    border-bottom: 1px solid var(--glass-amber);
    padding-bottom: 0.25rem;
  }

  .channels a:hover,
  .channels a:focus-visible {
    color: var(--glass-amber-lit);
  }

  .channels span {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    letter-spacing: 0.01em;
    color: var(--bone-faint);
  }

  @media (max-width: 60rem) {
    .lodge-body {
      grid-template-columns: 1fr;
    }
  }
</style>
