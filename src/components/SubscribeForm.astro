---
/**
 * The signup form, in its own component so the band is not half form.
 *
 * Its markup is out of the shipped HTML while `newsletter.live` is false, but
 * its ~0.5 KB of scoped CSS is not: Astro bundles styles by import graph, not by
 * render path, so a component that is imported and never rendered still
 * contributes its rules. Measured, and left alone — a dynamic import to dodge
 * half a kilobyte costs more than it saves.
 *
 * Posts cross-origin to a Supabase Edge Function, which is what lets the page
 * keep its zero client JavaScript: `type="email"` is the browser's own
 * validation and the 303 back to `/subscribed/` is the endpoint's answer.
 */
import { newsletter } from '../links';
---

<form class="subscribe" method="post" action={newsletter.action}>
  <label for="sub-email">By email</label>

  <div class="field">
    <input
      id="sub-email"
      type="email"
      name="email"
      required
      autocomplete="email"
      spellcheck="false"
      placeholder="you@example.com"
    />
    <button class="plaque" type="submit">Send it</button>
  </div>

  {/* Off-screen rather than hidden: a bot fills every field it can parse, a
      person never reaches this one. It is the only spam guard a form without
      JavaScript gets, so the function drops anything that fills it. */}
  <p class="decoy" aria-hidden="true">
    <label for="sub-quarry">Leave this empty</label>
    <input id="sub-quarry" type="text" name="quarry" tabindex="-1" autocomplete="off" />
  </p>

  <p class="mono-note">
    One mail per journal entry, nothing else. You confirm the address before anything is
    sent, every mail carries a one-click unsubscribe, and it is stored in Frankfurt and used
    for nothing but this.
  </p>
</form>

<style>
  .field {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  input[type='email'] {
    flex: 1 1 14rem;
    min-width: 0;
    padding: 0.85rem 1rem;
    border: var(--lead-w) solid var(--lead);
    /* the same slab the plaque beside it is: `--lead-soft` behind `--lead`, and
       the came's own pair so the border is a line rather than a declaration */
    box-shadow: var(--came-rule);
    background: var(--lead-soft);
    color: var(--bone);
    font-family: var(--font-mono);
    /* 0.95rem: the floor is 0.85rem and this is something you have to read back
       to check for a typo, so it sits a step above it */
    font-size: 0.95rem;
    letter-spacing: 0.01em;
  }

  input[type='email']::placeholder {
    color: var(--bone-faint);
    opacity: 0.7;
  }

  input[type='email']:focus-visible {
    outline: 2px solid var(--glass-amber-lit);
    outline-offset: 2px;
  }

  .decoy {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>
