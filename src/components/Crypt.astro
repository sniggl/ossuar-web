---
/** The footer, on all three pages. Names every channel that actually exists. */
import { reddit } from '../links';
import { url } from '../paths';
---

<footer class="crypt">
  <p>Ossuar — OSS-oo-ar, from <i>ossuary</i>. Built by sniggl.</p>
  {/* Both links stay on the line of the word before them: `compressHTML` drops the
      whitespace at a text→element newline, so a wrapped `or\n<a>` ships as "orby RSS". */}
  <p>
    Follow on <a href={reddit.href}>{reddit.handle}</a>, or <a href={url('/rss.xml')}>by RSS</a>.
    No newsletter and no Discord.
  </p>
</footer>
