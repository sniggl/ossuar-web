---
/**
 * The footer, on all three page shapes. It names no channel of its own: the
 * follow band on the index owns that list, and a footer that restates it is a
 * second copy to keep in step every time a channel is added.
 */
import { url } from '../paths';
---

<footer class="crypt">
  <p>Ossuar — OSS-oo-ar, from <i>ossuary</i>. Built by sniggl.</p>
  {/* The link stays on the line of the word before it: `compressHTML` drops the
      whitespace at a text→element newline, so a wrapped `is\n<a>` ships as "ison".
      A line here may only ever break between two runs of text. */}
  <p>
    Every way to follow is <a href={url('/#follow')}>on the front page</a>.
  </p>
</footer>
