---
import Base from '../layouts/Base.astro';
import Crypt from '../components/Crypt.astro';
import Masthead from '../components/Masthead.astro';
import Notice from '../components/Notice.astro';
import { entries } from '../data/journal';
import { url } from '../paths';
---

<Base
  title="Nothing glazed here yet — Ossuar"
  description="That page does not exist. The journal, and the game it is about, are here."
  path="/404"
  noindex
>
  <Masthead />

  <Notice eyebrow="Error 404" title="An empty light">
    <p class="standfirst">
      There is no glass in this one. Nothing was ever written here — which, this early, is
      true of most of the site.
    </p>

    <ul>
      <li><a href={url('/')}>Back to the front</a></li>
      {
        entries.slice(0, 2).map((e) => (
          <li>
            <a href={url(`/journal/${e.slug}/`)}>{e.title}</a>
          </li>
        ))
      }
    </ul>
  </Notice>

  <Crypt />
</Base>
