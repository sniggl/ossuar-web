---
import Base from '../layouts/Base.astro';
import Crypt from '../components/Crypt.astro';
import Masthead from '../components/Masthead.astro';
import { entries } from '../data/journal';
import { url } from '../paths';
---

<Base
  title="Nothing glazed here yet — Ossuar"
  description="That page does not exist. The journal, and the game it is about, are here."
  path="/404"
  noindex
>
  <Masthead />

  <main class="void">
    <p class="eyebrow">Error 404</p>
    <h1>An empty light</h1>
    <p class="standfirst">
      There is no glass in this one. Nothing was ever written here — which, this early, is
      true of most of the site.
    </p>

    <ul>
      <li><a href={url('/')}>Back to the front</a></li>
      {
        entries.slice(0, 2).map((e) => (
          <li>
            <a href={url(`/journal/${e.slug}/`)}>{e.title}</a>
          </li>
        ))
      }
    </ul>
  </main>

  <Crypt />
</Base>

<style>
  .void {
    max-width: 42rem;
    margin: 0 auto;
    padding: clamp(3rem, 12vh, 7rem) var(--gutter) clamp(4rem, 14vh, 8rem);
    /* the empty-glazing hatch from the journal, at full page scale */
    background: repeating-linear-gradient(
      135deg,
      transparent 0 11px,
      color-mix(in srgb, var(--bone) 2.8%, transparent) 11px 12px
    );
  }

  h1 {
    font-size: clamp(2.2rem, 7vw, 4rem);
    margin: 0.6rem 0 1.25rem;
  }

  ul {
    margin: 2.25rem 0 0;
    padding: 1.25rem 0 0;
    border-top: var(--lead-w) solid var(--lead);
    list-style: none;
    display: grid;
    gap: 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.1em;
  }

  ul a {
    color: var(--bone-dim);
    text-decoration: none;
    border-bottom: 1px solid var(--glass-amber);
    padding-bottom: 0.3rem;
  }

  ul a:hover,
  ul a:focus-visible {
    color: var(--bone);
  }
</style>
