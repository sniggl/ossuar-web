---
import Base from '../layouts/Base.astro';
import Crypt from '../components/Crypt.astro';
import Masthead from '../components/Masthead.astro';
import Notice from '../components/Notice.astro';
import { url } from '../paths';
---

<Base
  title="You are on the list — Ossuar"
  description="Confirmed. The next journal entry lands in your inbox."
  path="/confirmed"
  noindex
>
  <Masthead />

  <Notice eyebrow="Confirmed" title="You are on the list">
    <p class="standfirst">
      That is it. The next journal entry lands in your inbox the day it goes up, and every
      mail has an unsubscribe link at the bottom of it.
    </p>

    <ul>
      <li><a href={url('/')}>Back to the front</a></li>
      <li><a href={url('/#journal')}>The journal</a></li>
    </ul>
  </Notice>

  <Crypt />
</Base>
