---
import Base from '../layouts/Base.astro';
import Crypt from '../components/Crypt.astro';
import Masthead from '../components/Masthead.astro';
import Notice from '../components/Notice.astro';
import { entries } from '../data/journal';
import { url } from '../paths';
---

<Base
  title="You are on the list — Ossuar"
  description="Confirmed. The next journal entry lands in your inbox."
  path="/confirmed"
  noindex
>
  <Masthead />

  <Notice eyebrow="Confirmed" title="You are on the list">
    <p class="standfirst">
      {
        entries.length > 0
          ? 'That is it. The next journal entry lands in your inbox, and every mail has an unsubscribe link at the bottom of it.'
          : 'That is it. Nothing has been posted yet — the first entry goes out to you the day it does, and every mail has an unsubscribe link at the bottom of it.'
      }
    </p>

    <ul>
      <li><a href={url('/')}>Back to the front</a></li>
      <li><a href={url('/#journal')}>The journal</a></li>
    </ul>
  </Notice>

  <Crypt />
</Base>
