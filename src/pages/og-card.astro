---
/**
 * Capture surface for /og.png — not linked, noindex, kept out of the sitemap
 * and out of robots. Exists so the social card is the real window rather than
 * a mock of it: load /og-card at the size src/og.ts declares and screenshot it.
 */
import LeadedWindow from '../components/LeadedWindow.astro';
import { ogCard } from '../og';
import { paletteCss } from '../tokens';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Ossuar — social card</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Grenze+Gotisch:wght@500;900&family=Grenze:wght@400&family=JetBrains+Mono:wght@400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body style={paletteCss}>
    <div class="card" style={`width:${ogCard.width}px;height:${ogCard.height}px`}>
      {/* `still`, because this page is screenshotted headlessly: the idle pose
          and the sun's angle both advance on any capture path with a real clock,
          so without it the card lands on whichever frame the shot caught and a
          regeneration months later matches nothing. */}
      <div class="bay"><LeadedWindow still /></div>
      <div class="say">
        <p class="mark">Ossuar<span>.</span></p>
        <h1>He came back for a war.<em>The war ended without him.</em></h1>
        <p class="sub">
          A top-down action RPG, built in Unity, in the open — from the first commit.
        </p>
        {/* Displayed text, so it cannot derive from `site` in astro.config.mjs —
            this is the one place the domain is duplicated. public/og.png is a
            committed capture of this page, so the two have to move together. */}
        <p class="url">ossuar.braend.io</p>
      </div>
    </div>

    <style is:global>
      astro-dev-toolbar {
        display: none !important;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: var(--ink);
        --lead-w: 3px;
      }

      /* the box itself is set inline, from src/og.ts — the same numbers
         Base.astro advertises as og:image:width/height */
      .card {
        display: grid;
        /* `minmax(0, …)`, not a bare `1fr`: a bare fr track keeps an `auto`
           minimum, so the window's own min-content width dragged the bay past
           its share and squeezed the text column to a strip. */
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr);
        overflow: hidden;
      }

      .bay {
        display: flex;
        align-items: center;
        justify-content: center;
        /* the bay is the crop, exactly as `.window-bay` is on the live page */
        overflow: hidden;
        /* the lead came between bay and reading column — the same divider the
           live chancel draws, at the same weight */
        border-right: var(--lead-w) solid var(--lead);
        background:
          radial-gradient(
            90% 62% at 50% 46%,
            var(--bay-glow) 0%,
            var(--bay-fade) 58%,
            var(--ink) 100%
          ),
          var(--ink);
      }

      /* Explicit, because the card is a fixed 1200×630 and nothing here should
         depend on how a percentage happens to resolve. The box is the window's
         own 780×580 viewBox at the width the bay gives it, so `meet` letterboxes
         nothing and the outer lights are cropped by the viewBox exactly as they
         are on the live page. The card still carries the drop-shadow: it is a
         one-shot capture with nothing animating inside it, so the reason the
         live bay does the glow as a gradient does not apply here. */
      /* The window fills the card's full height and is cropped to the bay's width
         — the same arrangement as the live page, where the glazing has to reach
         the bay edge or the cut outer lights read as a fault (DESIGN.md §5).
         Sizing it the other way round is what the two failed attempts here both
         did: the window is landscape and the bay is portrait, so anything that
         fits it whole leaves a third of the card as dead ink above it.
         `aspect-ratio` supplies the width, so there is no second copy of the
         window's proportions to fall out of step, and `flex: none` is what stops
         the flex line shrinking that width back down. */
      /* `.card .bay .leaded`, not `.bay .leaded`. Astro stamps the component's
         own rule as `.leaded[data-astro-cid-…]`, which is also (0,2,0), and it is
         emitted after this block — so a two-class selector here loses the tie on
         source order and silently changes nothing. That is how the two previous
         attempts at this rule failed while looking correct in the source. */
      .card .bay .leaded {
        height: 100%;
        /* `auto` is load-bearing too: the component declares BOTH `width: 100%`
           and `height: 100%`, and two definite sides make `aspect-ratio` a
           no-op. Overriding only one of them leaves the box exactly as it was. */
        width: auto;
        aspect-ratio: 780 / 580;
        flex: none;
        filter: drop-shadow(0 12px 60px color-mix(in srgb, var(--glass-indigo) 60%, transparent));
      }

      .say {
        padding: 3rem 3.25rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 1.35rem;
        color: var(--bone);
      }

      .mark {
        margin: 0;
        font-family: 'Grenze Gotisch', serif;
        font-weight: 900;
        font-size: 2rem;
        letter-spacing: 0.18em;
        line-height: 1;
      }

      .mark span {
        color: var(--glass-amber);
      }

      h1 {
        margin: 0;
        font-family: 'Grenze Gotisch', serif;
        font-weight: 500;
        font-size: 3.1rem;
        line-height: 1.08;
        letter-spacing: 0.01em;
      }

      h1 em {
        display: block;
        font-style: normal;
        color: var(--glass-amber-lit);
      }

      .sub {
        margin: 0;
        font-family: 'Grenze', Georgia, serif;
        font-size: 1.32rem;
        line-height: 1.5;
        color: var(--bone-body);
        max-width: 26ch;
      }

      .url {
        margin: 0;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.95rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--glass-gold);
      }
    </style>
  </body>
</html>
