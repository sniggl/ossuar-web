---
import Base from '../layouts/Base.astro';
import Crypt from '../components/Crypt.astro';
import Masthead from '../components/Masthead.astro';
import Notice from '../components/Notice.astro';
import { channels } from '../links';
import { url } from '../paths';
---

<Base
  title="You are off the list — Ossuar"
  description="Unsubscribed. Nothing else will be sent to that address."
  path="/unsubscribed"
  noindex
>
  <Masthead />

  <Notice eyebrow="Done" title="You are off the list">
    <p class="standfirst">
      Nothing else goes to that address. No hard feelings and no exit survey — the feed and
      the rest of it are still open if you want the build without the inbox.
    </p>

    <ul>
      <li><a href={url('/rss.xml')}>The feed</a></li>
      {channels.map((c) => (
        <li>
          <a href={c.href}>{c.handle}</a>
        </li>
      ))}
    </ul>
  </Notice>

  <Crypt />
</Base>
