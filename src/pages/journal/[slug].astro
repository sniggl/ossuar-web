---
import Base from '../../layouts/Base.astro';
import Crypt from '../../components/Crypt.astro';
import Masthead from '../../components/Masthead.astro';
import { entries } from '../../data/journal';
import { channels, feed } from '../../links';
import { url } from '../../paths';
import { dayOf } from '../../project';

export function getStaticPaths() {
  return entries.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
/* entries is newest first, so the one after this is the one before it. */
const index = entries.findIndex((e) => e.slug === entry.slug);
const older = entries[index + 1];
/* UTC, or this reads a day off from the <time> and the feed on a build west of
   Greenwich — and which day ships would depend on who ran the build. */
const shown = new Date(entry.date).toLocaleDateString('en-GB', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
/* the first image is the one a reader waits on, so it is the one that loads eagerly */
const lead = entry.body.findIndex((b) => b.kind === 'figure');

/**
 * Most people meet this site one entry at a time, from a feed or a link — they
 * never see the index, so they never see the follow band or the day counter. So
 * the foot of an entry carries both: where this post sits in the run, and how
 * far into the build it landed. Derived, like every other number here — the
 * position from the array, the day from the entry's own date.
 */
const position = entries.length - index;
const day = String(dayOf(entry.date)).padStart(3, '0');
const follow = [...channels, { ...feed, href: url(feed.href) }];
---

<Base
  title={`${entry.title} — Ossuar`}
  description={entry.blurb}
  path={`/journal/${entry.slug}/`}
  ogType="article"
  publishedAt={entry.date}
>
  <Masthead />

  <main class="entry-page" style={`--tint:var(--glass-${entry.tint})`}>
    <div class="entry">
      <article>
      <p class="entry-meta">
        <time datetime={entry.date}>{shown}</time>
        <span class="tag">{entry.tag}</span>
      </p>

      <h1>{entry.title}</h1>
      <p class="lede">{entry.blurb}</p>

      {
        entry.body.map((block, i) => {
          if (block.kind === 'p') return <p>{block.text}</p>;

          if (block.kind === 'figure')
            return (
              <figure class="shot">
                <img
                  src={url(block.src)}
                  alt={block.alt}
                  width={block.width}
                  height={block.height}
                  loading={i === lead ? 'eager' : 'lazy'}
                  class={block.pixelated ? 'px' : undefined}
                />
                <figcaption>{block.caption}</figcaption>
              </figure>
            );

          if (block.kind === 'strip')
            return (
              <figure class="strip">
                <div class="strip-rail">
                  {block.images.map((img) => (
                    <span>
                      <img
                        src={url(img.src)}
                        alt={img.alt}
                        width="100"
                        height="100"
                        loading="lazy"
                      />
                      {img.name}
                    </span>
                  ))}
                </div>
                <figcaption>{block.caption}</figcaption>
              </figure>
            );

          return (
            <aside class="note">
              <h2>{block.heading}</h2>
              <p>{block.text}</p>
            </aside>
          );
        })
      }

      </article>

      {/* The end of a post is the one moment a stranger has decided they like
          this. Until now it offered them a single link back to an index they
          have probably never seen. */}
      <aside class="entry-follow">
        <h2>Follow the build</h2>
        <p class="mono-note">Entry {position} of {entries.length} · day {day}</p>
        <ul class="channels">
          {follow.map((c) => (
            <li>
              <a href={c.href}>{c.handle}</a>
            </li>
          ))}
        </ul>
      </aside>

      <nav class="entry-nav" aria-label="Journal">
        <a class="back" href={url('/#journal')}>← All entries</a>
        {
          older && (
            <a class="older" href={url(`/journal/${older.slug}/`)}>
              <span class="older-slug">Older post</span>
              <span class="older-title">{older.title}</span>
            </a>
          )
        }
      </nav>
    </div>
  </main>

  <Crypt />
</Base>

<style>
  /* An entry is a single pane taken out of the window and read close up. The
     tint lights the head of the page the way it lights the pane this entry came
     from, and it sits on the full-width element so the light has no edges. */
  .entry-page {
    background:
      radial-gradient(
        46% 22rem at 50% 0%,
        color-mix(in srgb, var(--tint) 34%, transparent) 0%,
        transparent 72%
      );
  }

  .entry {
    max-width: 46rem;
    margin: 0 auto;
    padding: clamp(2rem, 5vw, 3.5rem) var(--gutter) clamp(3rem, 7vw, 5rem);
  }

  .entry-meta {
    display: flex;
    gap: 1.25rem;
    align-items: baseline;
    flex-wrap: wrap;
    margin: 0 0 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .entry-meta time {
    color: var(--bone-dim);
  }

  .entry-meta .tag {
    color: var(--glass-gold);
  }

  h1 {
    font-size: clamp(1.9rem, 4.4vw, 3rem);
    line-height: 1.06;
    max-width: 22ch;
    text-wrap: balance;
  }

  /* `article p.lede`, not `.lede`. Astro scopes both selectors with the same
     attribute, which leaves a bare class at (0,2,0) against `article p` at
     (0,2,2) — so the standfirst was losing both its colour and its measure to
     the rule below and rendering as paragraph one, 135px wider than designed
     with no brightness step. It is the hinge between a 48px title and 23px
     body; without the step there is no hinge. */
  article p.lede {
    margin: 1.25rem 0 0;
    font-size: 1.16em;
    line-height: 1.55;
    color: var(--bone);
    max-width: 38ch;
    text-wrap: pretty;
  }

  /* 50ch, not 62. `ch` is the width of a `0`, and Grenze's is ~24% wider than
     its average lowercase letter, so 62ch measured 76–88 real characters — and
     it only bound at all around 768px, because `--gutter` grows with the
     viewport inside a fixed 46rem column and the measure *narrows* as the screen
     widens. 50ch lands ~62 characters and binds everywhere above the phone. */
  article p {
    color: var(--bone-body);
    max-width: 50ch;
  }

  /* a screenshot or a gif, leaded like everything else, reclaiming the gutter */
  .shot {
    margin: 2.25rem 0;
    width: calc(100% + 2 * var(--gutter));
    margin-inline: calc(-1 * var(--gutter));
  }

  /* A ceiling, because a devlog posts tall things — a 700×1400 UI panel was
     rendering at 1.94 viewport heights with no way to see it whole. `width:auto`
     is what makes the cap keep the aspect ratio, and it also stops a small
     figure being stretched to the bleed, which for pixel art was never right. */
  .shot img {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 80svh;
    margin-inline: auto;
    border-block: var(--lead-w) solid var(--lead);
    background: var(--lead);
    /* the came's own light and shadow: --lead on --ink is 1.02:1, so the border
       alone is a rule nobody can see. The pair is named in global.css — these
       four edges each carried their own copy of both literals until the index
       needed the same thing at seven more. */
    box-shadow: var(--came-rule);
  }

  .shot img.px {
    image-rendering: pixelated;
  }

  /* A caption had no measure at all and ran the full bleed — ~92 characters
     while the paragraphs above it were capped. 62ch is exact here: the caption
     is monospaced, so a `ch` really is one character. */
  .shot figcaption {
    margin: 0.85rem var(--gutter) 0;
    max-width: 62ch;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1.6;
    letter-spacing: 0.01em;
    color: var(--bone-faint);
  }

  /* The sprite layers, at true pixel scale — 1:1, because any other size
     resamples pixel art. The rail reclaims the gutter so all seven fit one row
     on a desktop measure that would otherwise only hold five. */
  .strip {
    margin: 2.25rem 0;
    width: calc(100% + 2 * var(--gutter));
    margin-inline: calc(-1 * var(--gutter));
  }

  .strip-rail {
    display: grid;
    /* 6.25rem is the sprite's own 100px — the cell never squeezes the art, and
       seven of them fit the reclaimed width in one row */
    grid-template-columns: repeat(auto-fit, minmax(6.25rem, 1fr));
    gap: var(--lead-w);
    background: var(--lead);
    border-block: var(--lead-w) solid var(--lead);
    box-shadow: var(--came-rule);
  }

  .strip-rail span {
    background: radial-gradient(90% 80% at 50% 30%, color-mix(in srgb, var(--tint) 40%, transparent), transparent 70%),
      var(--ink);
    padding: 0.9rem 0 0.7rem;
    display: grid;
    justify-items: center;
    gap: 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    /* tighter than the rest of the mono: BELL-EATER has to sit inside 100px */
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--bone-dim);
  }

  .strip-rail img {
    width: 100px;
    height: 100px;
    image-rendering: pixelated;
  }

  .strip figcaption {
    margin: 0.85rem var(--gutter) 0;
    max-width: 62ch;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1.6;
    letter-spacing: 0.01em;
    color: var(--bone-faint);
  }

  /* the correction, the caveat, the thing left alone on purpose */
  .note {
    margin: 2.25rem 0;
    padding: 1.25rem 0 1.25rem 1.4rem;
    border-left: var(--lead-w) solid var(--glass-gold);
  }

  .note h2 {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--glass-gold);
    margin-bottom: 0.6rem;
  }

  .note p {
    margin: 0;
  }

  /* Most readers meet this site one entry at a time and never see the index, so
     the follow band comes to them. Not a second FollowBand — the same list from
     links.ts, set as a row, with the heading at the same size the index's bands
     use because for these readers it is the only one. */
  .entry-follow {
    margin-top: clamp(2.5rem, 6vw, 3.5rem);
    padding-top: clamp(1.5rem, 3vw, 2rem);
    border-top: var(--lead-w) solid var(--lead);
    box-shadow: var(--came-top);
  }

  .entry-follow h2 {
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    letter-spacing: 0.04em;
  }

  .entry-follow .mono-note {
    margin: 0.5rem 0 0;
  }

  .entry-follow .channels {
    margin: 1.35rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    /* the row gap matches the masthead's for the same reason: the 44px hit boxes
       reach 0.7rem past each link, and any tighter has two rows of them fighting
       over the same tap */
    gap: 1.5rem clamp(1.25rem, 2.5vw, 2.25rem);
  }

  .entry-nav {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: var(--lead-w) solid var(--lead);
    box-shadow: var(--came-top);
    display: flex;
    /* `start`, or a link stretches to the height of its tallest sibling: the
       back link measured 51px of box around 18px of text, so its hover underline
       and its focus ring both drew a full line-height below the word. */
    align-items: start;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  /* `position` here, the 44px box itself in global.css beside the masthead's.
     This link had neither, and collapsed to 29px whenever it had no two-line
     sibling to inherit height from — which is every entry on a phone, and the
     oldest entry everywhere. */
  .entry-nav a {
    position: relative;
    color: var(--bone-dim);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    padding-bottom: 0.35rem;
    transition: color 0.18s, border-color 0.18s;
  }

  .entry-nav a:hover,
  .entry-nav a:focus-visible {
    color: var(--bone);
    border-bottom-color: var(--glass-amber);
  }

  .back {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.1em;
  }

  /* This was a bare title in tracked mono with a `→` after it — a forward arrow
     on a link that goes backwards, wrapping to two or three lines at every width
     because label tracking on a 62-character title measures ~590px. The slug
     says the direction now, so the arrow is gone, and the title is set in the
     body face where the same 62 characters fit one line. */
  .older {
    display: grid;
    gap: 0.3rem;
    justify-items: end;
    text-align: right;
    max-width: 24rem;
  }

  .older-slug {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--bone-faint);
  }

  .older-title {
    font-size: 1.05rem;
    line-height: 1.6;
  }
</style>
